# Copy to .env, fill in the values, then restart Expo with `npx expo start -c`.
#
# EXPO_PUBLIC_* values are copied into the app bundle and can be read by
# anyone who has the app. Only PUBLIC values belong here. Never put the
# Supabase secret key (sb_secret_...), a service_role key, a database
# password or an access token in this file; the app refuses a secret key.

# Address of the NeighborShare API (../backend), without /api/v1.
#   Expo web / iOS simulator on the same computer: http://localhost:4000
#   Android emulator:                              http://10.0.2.2:4000
#   Physical phone on the same Wi-Fi:              http://YOUR_DEVELOPMENT_MACHINE_IP:4000
#     (find the IPv4 address with `ipconfig` in PowerShell)
EXPO_PUBLIC_API_URL=http://YOUR_DEVELOPMENT_MACHINE_IP:4000

# Used ONLY for Google sign-in (starting the flow and exchanging its code).
# All other auth and data requests go through the API.
# Supabase dashboard -> Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
