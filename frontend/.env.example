# Copy to .env and set the address of the NeighborShare API (backend/).
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone, so no
# keys or credentials ever go here. The app talks only to the API; it never
# connects to Supabase directly.
#
# Which address to use:
#   Expo web / iOS simulator on the same computer: http://localhost:4000
#   Android emulator:                              http://10.0.2.2:4000
#   Physical phone (Expo Go) on the same Wi-Fi:    http://YOUR_DEVELOPMENT_MACHINE_IP:4000
#     (find the IPv4 address with `ipconfig` in PowerShell)
EXPO_PUBLIC_API_URL=http://YOUR_DEVELOPMENT_MACHINE_IP:4000
