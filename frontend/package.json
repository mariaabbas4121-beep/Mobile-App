  "private": true,
  "description": "Project Name : NeighborShare\r Platform : React Native (Expo Router)\r Backend : Node.js/Express API with Supabase (see ../backend)\r Course : Mobile Application Development\r Submitted By : Maria Abbas (2023-ag-9845)",
  "homepage": "https://github.com/mariaabbas4121-beep/Mobile-App#readme",
  "bugs": {
    "url": "https://github.com/mariaabbas4121-beep/Mobile-App/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariaabbas4121-beep/Mobile-App.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "2.118.0",
    "expo": "^58.0.20",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.13",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePaths": [
      "<rootDir>/node_modules/expo/node_modules"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|react-native-url-polyfill)"
    ],
    "testTimeout": 30000
  }
}
