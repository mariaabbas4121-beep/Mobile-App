{
  "name": "neighborshare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NeighborShare REST API (Node.js, Express, TypeScript, Supabase)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --project db",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:migrations": "supabase migration list --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "db:new": "supabase migration new",
    "test:all": "npm run typecheck && vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supabase": "^2.121.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
