# Copy to .env and replace the placeholders. These are NOT real credentials.
# The API refuses to start until SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY
# hold real values. Everything in this file stays on the server. The mobile app never receives
# any of these values; it only knows the API's address.

PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (Expo web runs on 8081).
# Native mobile apps send no Origin header and are not restricted by this.
FRONTEND_ORIGIN=http://localhost:8081
# Optional. fatal|error|warn|info|debug|trace|silent (default info; silent in test)
LOG_LEVEL=
# Optional. Reverse-proxy hops in front of the API, used for client IPs in
# rate limiting. 0 when clients connect directly.
TRUST_PROXY_HOPS=0

# Supabase dashboard -> Project Settings -> Data API (Project URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# Used for Supabase Auth calls (sign-up, sign-in, refresh, token verification)
# and for database/storage requests made on behalf of a signed-in user, which
# remain subject to Row-Level Security.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Secret key (sb_secret_...). It BYPASSES Row-Level Security: leave it empty
# until a privileged server-only operation needs it. Never log it, return it
# in a response, or copy it into the frontend.
SUPABASE_SECRET_KEY=

# Optional. Where the confirmation-email link lands after Supabase verifies
# it, and where Google OAuth returns. Each must also be added under Supabase
# dashboard -> Authentication -> URL Configuration -> Redirect URLs.
AUTH_EMAIL_REDIRECT_URL=
AUTH_OAUTH_REDIRECT_URL=

# --- Integration tests only (npm run test:integration) ---
# They create and delete throwaway users in the project, so they refuse to
# run unless this equals the project ref in SUPABASE_URL. Only ever set it
# for a development/test project. Requires SUPABASE_SECRET_KEY.
INTEGRATION_PROJECT_REF=
# Optional: a mailbox you own, for the one test that performs a real signup
# and sends a real confirmation email. Skipped when empty or when the
# address already has an account.
INTEGRATION_SIGNUP_EMAIL=
