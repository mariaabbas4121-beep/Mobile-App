# Copy to .env and replace the placeholders. These are NOT real credentials.
# The API starts without Supabase values; only Supabase-backed requests need them.
# Everything in this file stays on the server. The mobile app never receives
# any of these values; it only knows the API's address.

PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (Expo web runs on 8081).
# Native mobile apps send no Origin header and are not restricted by this.
FRONTEND_ORIGIN=http://localhost:8081

# Supabase dashboard -> Project Settings -> Data API (Project URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# Used for Supabase Auth calls (sign-up, sign-in, refresh, token verification)
# and for database/storage requests made on behalf of a signed-in user, which
# remain subject to Row-Level Security.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Secret key (sb_secret_...). It BYPASSES Row-Level Security: leave it empty
# until a privileged server-only operation needs it. Never log it, return it
# in a response, or copy it into the frontend.
SUPABASE_SECRET_KEY=
