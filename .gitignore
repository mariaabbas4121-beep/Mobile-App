# Rules here apply to frontend/ and backend/ as well (patterns without a
# leading slash match at any depth).

# Dependencies
node_modules/

# Environment files: keep the templates, never the real values
.env
.env.*
!.env.example

# Build output and caches
dist/
web-build/
build/
coverage/
.expo/
.metro-health-check*
*.tsbuildinfo

# Native folders generated by `expo prebuild`
frontend/android/
frontend/ios/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
*.swp
